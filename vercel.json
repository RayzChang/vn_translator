{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "functions": {
    "api/auth/login.ts": { "includeFiles": "api/lib/**" },
    "api/auth/register.ts": { "includeFiles": "api/lib/**" },
    "api/settings/index.ts": { "includeFiles": "api/lib/**" },
    "api/translate/index.ts": { "includeFiles": "api/lib/**" },
    "api/vocabulary/index.ts": { "includeFiles": "api/lib/**" }
  }
}
